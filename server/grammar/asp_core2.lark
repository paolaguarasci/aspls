start: statement*

statement: directive
         | fact
         | rule
         | constraint

directive: "#const" IDENTIFIER "=" INT "." -> const_directive
         | "#show" IDENTIFIER "/" INT "." -> show_directive
         | "#minimize" "{" weighted_literal ("," weighted_literal)* "}" "." -> minimize_directive

weighted_literal: naf_literal "@" INT
                 | naf_literal

head: disjunction
disjunction: literal (";" literal)*

fact: head "."
rule: head ":-" body "."
constraint: ":-" body "."

body: naf_literal ("," naf_literal)*
naf_literal: "not" literal -> negated_literal
           | comparison
           | aggregate
           | literal

comparison: comparison_operand COMPARE_OP comparison_operand
comparison_operand: aggregate | term

aggregate: AGGREGATE_FN "{" aggregate_elem ("," aggregate_elem)* "}"
aggregate_elem: term_tuple ":" body
              | body
term_tuple: term ("," term)*

AGGREGATE_FN: "#count" | "#sum" | "#max" | "#min"
COMPARE_OP: "<" | "<=" | ">" | ">=" | "=" | "!="

literal: atom

atom: IDENTIFIER "(" term ("," term)* ")" -> compound_atom
    | IDENTIFIER -> nullary_atom

term: VARIABLE -> var_term
    | IDENTIFIER -> const_term
    | range_bound ".." range_bound -> range_term
    | INT -> int_term

range_bound: INT | IDENTIFIER | VARIABLE

VARIABLE: /[A-Z_][a-zA-Z0-9_]*/
IDENTIFIER: /[a-z][a-zA-Z0-9_]*/
INT: /-?[0-9]+/

COMMENT: /%[^\n]*/
%import common.WS
%ignore WS
%ignore COMMENT
