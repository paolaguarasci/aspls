start: statement*

statement: directive
         | fact
         | rule
         | constraint
         | weak_constraint

directive: "#const" IDENTIFIER "=" INT "." -> const_directive
         | "#show" IDENTIFIER "/" INT "." -> show_directive
         | "#minimize" "{" minimize_elem (";" minimize_elem)* "}" "." -> minimize_directive
         | "#include" STRING "." -> include_directive
         | "#external" literal (":" body)? "." -> external_directive
         | "#heuristic" literal (":" body)? "." HEURISTIC_SUFFIX? -> heuristic_directive
         | "#program" IDENTIFIER ("(" term ("," term)* ")")? "." -> program_directive

// Optional [weight@priority, modifier] after #heuristic (tolerant inner text).
HEURISTIC_SUFFIX: /\s*\[[^\]]*\]/

// Clingo: #minimize { weight@priority, t1, t2, ... : body ; ... }.
minimize_elem: term ("@" INT)? ("," term)* ":" body

head: disjunction
     | choice

disjunction: literal (";" literal)*

// Clingo choice: [lower] { elem ; elem ; ... } [upper] (bounds: INT | IDENTIFIER | VARIABLE)
choice: range_bound? "{" choice_elem (";" choice_elem)* "}" range_bound?
choice_elem: literal (":" body)?

fact: head "."
rule: head ":-" body "."
constraint: ":-" body "."

// Clingo weak constraint: :~ body. [weight@priority, t1, t2, ...]
// Weight bracket must stay on the same '.'-containing fragment (line splitter).
weak_constraint: ":~" body "." "[" weak_weight "]"
weak_weight: term ("@" INT)? ("," term)*

body: naf_literal ("," naf_literal)*
naf_literal: "not" literal -> negated_literal
           | comparison
           | aggregate
           | literal

comparison: aggregate COMPARE_OP term -> aggregate_cmp_term
          | term COMPARE_OP aggregate -> term_cmp_aggregate
          | term COMPARE_OP term -> term_cmp_term

aggregate: AGGREGATE_FN "{" aggregate_elem (";" aggregate_elem)* "}"
aggregate_elem: term_tuple ":" body
              | body
term_tuple: term ("," term)*

AGGREGATE_FN: "#count" | "#sum" | "#max" | "#min"
COMPARE_OP: "<" | "<=" | ">" | ">=" | "=" | "!="

literal: atom

atom: IDENTIFIER "(" term ("," term)* ")" -> compound_atom
    | IDENTIFIER -> nullary_atom

term: VARIABLE -> var_term
    | IDENTIFIER -> const_term
    | range_bound ".." range_bound -> range_term
    | INT -> int_term

range_bound: INT | IDENTIFIER | VARIABLE

VARIABLE: /[A-Z_][a-zA-Z0-9_]*/
IDENTIFIER: /[a-z][a-zA-Z0-9_]*/
INT: /-?[0-9]+/
STRING: /"[^"]*"/

COMMENT: /%[^\n]*/
%import common.WS
%ignore WS
%ignore COMMENT
