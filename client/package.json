{
    "name": "aspls",
    "displayName": "aspls — Answer Set Programming (Clingo)",
    "description": "Language support for Answer Set Programming (ASP-Core-2 / Clingo): run Clingo, answer-set results sidebar, syntax highlighting, diagnostics, completion, hover, go-to-definition, find-references.",
    "version": "0.4.0",
    "publisher": "paolaguarasci",
    "author": "Paola Guarasci",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/paolaguarasci/aspls.git"
    },
    "bugs": {
        "url": "https://github.com/paolaguarasci/aspls/issues"
    },
    "homepage": "https://github.com/paolaguarasci/aspls#readme",
    "icon": "images/icon.png",
    "galleryBanner": {
        "color": "#1e2430",
        "theme": "dark"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "keywords": [
        "clingo",
        "potassco",
        "answer-set-programming",
        "answer set programming",
        "asp-core-2",
        "logic programming",
        "asp"
    ],
    "activationEvents": [
        "onLanguage:asp",
        "onView:aspls.solver",
        "onView:aspls.predicates",
        "onCommand:aspls.cookbook.open"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "aspls.clingo.computeFirst",
                "title": "Compute first answer set",
                "category": "aspls",
                "icon": "$(play)"
            },
            {
                "command": "aspls.clingo.computeAll",
                "title": "Compute all answer sets",
                "category": "aspls",
                "icon": "$(run-all)"
            },
            {
                "command": "aspls.clingo.computeWithConfig",
                "title": "Compute answer sets (config)",
                "category": "aspls",
                "icon": "$(settings-gear)"
            },
            {
                "command": "aspls.clingo.rerun",
                "title": "Re-run Clingo",
                "category": "aspls",
                "icon": "$(refresh)"
            },
            {
                "command": "aspls.clingo.initConfig",
                "title": "Initialize Clingo config file",
                "category": "aspls"
            },
            {
                "command": "aspls.cookbook.open",
                "title": "Open Code Cookbook",
                "category": "aspls",
                "icon": "$(book)"
            },
            {
                "command": "aspls.predicates.toggleWorkspace",
                "title": "Show Workspace Predicates",
                "category": "aspls",
                "icon": "$(folder-library)"
            }
        ],
        "menus": {
            "editor/context": [
                {
                    "when": "resourceLangId == asp",
                    "command": "aspls.clingo.computeFirst",
                    "group": "aspls@1"
                },
                {
                    "when": "resourceLangId == asp",
                    "command": "aspls.clingo.computeAll",
                    "group": "aspls@2"
                },
                {
                    "when": "resourceLangId == asp",
                    "command": "aspls.clingo.computeWithConfig",
                    "group": "aspls@3"
                },
                {
                    "when": "resourceLangId == asp",
                    "command": "aspls.cookbook.open",
                    "group": "aspls@4"
                }
            ],
            "editor/title": [
                {
                    "when": "resourceLangId == asp",
                    "command": "aspls.clingo.computeFirst",
                    "group": "navigation@1"
                },
                {
                    "when": "resourceLangId == asp",
                    "command": "aspls.clingo.computeAll",
                    "group": "navigation@2"
                },
                {
                    "when": "resourceLangId == asp",
                    "command": "aspls.cookbook.open",
                    "group": "navigation@3"
                }
            ],
            "view/title": [
                {
                    "command": "aspls.clingo.computeFirst",
                    "when": "view == aspls.solver",
                    "group": "navigation@1"
                },
                {
                    "command": "aspls.clingo.computeAll",
                    "when": "view == aspls.solver",
                    "group": "navigation@2"
                },
                {
                    "command": "aspls.clingo.computeWithConfig",
                    "when": "view == aspls.solver",
                    "group": "navigation@3"
                },
                {
                    "command": "aspls.clingo.rerun",
                    "when": "view == aspls.solver",
                    "group": "navigation@4"
                },
                {
                    "command": "aspls.predicates.toggleWorkspace",
                    "when": "view == aspls.predicates",
                    "group": "navigation@1",
                    "toggled": "aspls.predicates.workspaceMode"
                }
            ]
        },
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "aspls",
                    "title": "ASP",
                    "icon": "images/activitybar-asp.svg"
                }
            ]
        },
        "views": {
            "aspls": [
                {
                    "type": "webview",
                    "id": "aspls.solver",
                    "name": "Solver"
                },
                {
                    "id": "aspls.predicates",
                    "name": "Predicates"
                }
            ]
        },
        "languages": [
            {
                "id": "asp",
                "aliases": [
                    "ASP",
                    "Answer Set Programming"
                ],
                "extensions": [
                    ".lp",
                    ".asp"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "asp",
                "scopeName": "source.asp",
                "path": "./syntaxes/asp.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "asp",
                "path": "./snippets/asp.json"
            }
        ],
        "semanticTokenTypes": [
            {
                "id": "aspFact",
                "description": "Predicate occurring in a fact"
            },
            {
                "id": "aspRuleHead",
                "description": "Predicate occurring in a rule head"
            },
            {
                "id": "aspRuleBody",
                "description": "Predicate occurring in a rule body"
            },
            {
                "id": "aspConstraint",
                "description": "Predicate occurring in a constraint"
            },
            {
                "id": "aspShow",
                "description": "Predicate referenced by #show"
            },
            {
                "id": "aspMinimize",
                "description": "Predicate occurring in #minimize"
            }
        ],
        "semanticTokenModifiers": [
            {
                "id": "aspNegated",
                "description": "Negated with not"
            }
        ],
        "semanticTokenScopes": [
            {
                "language": "asp",
                "scopes": {
                    "aspFact": [
                        "entity.name.function.asp.fact"
                    ],
                    "aspRuleHead": [
                        "entity.name.function.asp.rule.head"
                    ],
                    "aspRuleBody": [
                        "entity.name.function.asp.rule.body"
                    ],
                    "aspConstraint": [
                        "entity.name.function.asp.constraint"
                    ],
                    "aspShow": [
                        "entity.name.function.asp.show"
                    ],
                    "aspMinimize": [
                        "entity.name.function.asp.minimize"
                    ]
                }
            }
        ],
        "configurationDefaults": {
            "[asp]": {
                "editor.semanticHighlighting.enabled": true
            },
            "editor.semanticTokenColorCustomizations": {
                "rules": {
                    "aspFact:asp": {
                        "foreground": "#3f9d6a",
                        "fontStyle": "bold"
                    },
                    "aspRuleHead:asp": {
                        "foreground": "#4d8fd6",
                        "fontStyle": "bold"
                    },
                    "aspRuleBody:asp": {
                        "foreground": "#9aa0a6"
                    },
                    "aspConstraint:asp": {
                        "foreground": "#d4775a",
                        "fontStyle": "italic"
                    },
                    "aspShow:asp": {
                        "foreground": "#c9a227"
                    },
                    "aspMinimize:asp": {
                        "foreground": "#b07cc6"
                    },
                    "aspRuleBody.aspNegated:asp": {
                        "foreground": "#9aa0a6",
                        "fontStyle": "italic"
                    }
                }
            }
        },
        "configuration": {
            "title": "aspls",
            "properties": {
                "aspls.pythonPath": {
                    "type": "string",
                    "default": "",
                    "description": "Path to a Python 3 interpreter. Leave empty to auto-detect python3/python on PATH."
                },
                "aspls.rainbowPredicates": {
                    "type": "boolean",
                    "default": true,
                    "description": "Underline each predicate name with a stable rainbow color derived from its name (role colors come from semantic highlighting)."
                },
                "aspls.diagnostics.onceUsed": {
                    "type": "boolean",
                    "default": true,
                    "description": "Warn when a predicate appears only once as a use (rule body/constraint). Skips lone definitions and predicates also referenced by #show / #minimize."
                },
                "aspls.learnerMode": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable learner Information hints: recommended rule order and missing preceding comments, plus Fix Order and Add preceding comment quick fixes. Off by default so power users are not noisy."
                },
                "aspls.clingo.usePath": {
                    "type": "boolean",
                    "default": false,
                    "description": "Use the Clingo binary from PATH (or aspls.clingo.path) instead of the bundled WASM solver."
                },
                "aspls.clingo.path": {
                    "type": "string",
                    "default": "",
                    "description": "Optional absolute path to the Clingo executable. Empty = look up `clingo` on PATH when usePath is enabled."
                },
                "aspls.clingo.models": {
                    "type": "number",
                    "default": 1,
                    "description": "Default number of models for config-based runs (0 = enumerate all). First/all commands override this."
                },
                "aspls.clingo.threads": {
                    "type": "number",
                    "default": 1,
                    "minimum": 1,
                    "description": "Clingo thread count (-t)."
                },
                "aspls.clingo.customArgs": {
                    "type": "string",
                    "default": "",
                    "description": "Extra Clingo CLI arguments (escape hatch). Split on whitespace; use quotes for values with spaces."
                },
                "aspls.clingo.additionalFiles": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "markdownDeprecationMessage": "**Deprecated** — use `additionalFiles` in your workspace Clingo config file (`aspls.clingo.json` by default). This setting is only copied into the config file when you run **aspls: Initialize Clingo config file** or when the extension creates the file for the Solver sidebar; it no longer affects runs or the language server.",
                    "description": "Deprecated. Extra .lp/.asp files — migrate to aspls.clingo.json `additionalFiles`."
                },
                "aspls.clingo.configFile": {
                    "type": "string",
                    "default": "aspls.clingo.json",
                    "description": "Workspace-relative Clingo config file name (models, threads, constants, customArgs, additionalFiles)."
                }
            }
        }
    },
    "scripts": {
        "compile": "bash scripts/copy-server.sh && tsc -p .",
        "watch": "tsc -watch -p .",
        "test": "npm run compile && node out/predicateRainbow.test.js && node out/clingoResultParse.test.js && node out/clingoConfigCore.test.js && node out/clingoPreflight.test.js && node out/clingoCapabilities.test.js && node out/stabilityBd.regression.test.js && node out/clingoRunnerParity.smoke.test.js && node out/clingoIncludes.test.js && node out/cookbook/recipes.test.js && node out/predicatesTreeMap.test.js",
        "vscode:prepublish": "npm run compile",
        "package": "vsce package",
        "publish:marketplace": "vsce publish",
        "publish:openvsx": "ovsx publish"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.85.0",
        "@vscode/vsce": "^3.9.2",
        "ovsx": "^0.10.12",
        "typescript": "^5.4.0"
    },
    "dependencies": {
        "clingo-wasm": "^0.3.2",
        "vscode-languageclient": "^9.0.1"
    }
}
