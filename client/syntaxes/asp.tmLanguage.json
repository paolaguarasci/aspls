{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "ASP",
    "scopeName": "source.asp",
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#directives"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#variables"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#atoms"
        }
    ],
    "repository": {
        "comments": {
            "match": "%.*$",
            "name": "comment.line.percentage.asp"
        },
        "directives": {
            "match": "#(const|show|minimize|maximize|count|sum|max|min)\\b",
            "name": "keyword.control.directive.asp"
        },
        "numbers": {
            "match": "\\b-?[0-9]+\\b",
            "name": "constant.numeric.asp"
        },
        "variables": {
            "match": "\\b[A-Z_][a-zA-Z0-9_]*\\b",
            "name": "variable.parameter.asp"
        },
        "operators": {
            "match": ":-|;|,|\\.\\.|<=|>=|!=|<|>|=|\\bnot\\b",
            "name": "keyword.operator.asp"
        },
        "atoms": {
            "match": "\\b[a-z][a-zA-Z0-9_]*\\b",
            "name": "entity.name.function.asp"
        }
    }
}